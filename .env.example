# Tamil Nadu Power Center — environment configuration
# Copy to .env for local use, or set these as function environment variables.
# NEVER commit a filled-in copy. The project portal is the system of record.

# --- Project portal OAuth --------------------------------------------------
# Obtain from the India API console as a Self Client. See docs/DEPLOY.md.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

ZOHO_PORTAL_ID=60083686827
ZOHO_ACCOUNTS_BASE=https://accounts.zoho.in

# If reads 404 with a token that is definitely valid, try the alternate host:
#   https://projectsapi.zoho.in/api/v3
ZOHO_API_BASE=https://projects.zoho.in/api/v3

# CORS is owned by the hosting platform (whitelist the UI origin). Leave this
# unset there — if the function also sets the header the browser sees it twice
# and blocks the response. Set true only when serving the client from a
# different origin outside the platform.
# SEND_CORS_HEADERS=true

# Used only to build deep links back into the portal UI.
ZOHO_PORTAL_NAME=jeyasuriyadotjscmzohotestdotcom

# --- Session signing -------------------------------------------------------
# Generate with: openssl rand -base64 36
AUTH_SIGNING_KEY=
AUTH_TOKEN_TTL_SECONDS=28800

# --- Local server ----------------------------------------------------------
PORT=4000
NODE_ENV=development
