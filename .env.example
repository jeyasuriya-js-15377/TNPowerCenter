# Tamil Nadu Power Center — environment configuration
# Copy to .env for local use, or set these as Catalyst environment variables.
# NEVER commit a filled-in copy. There is no database here: Zoho Projects is
# the only system of record.

# --- Zoho Projects (the database) ------------------------------------------
# Obtain from https://api-console.zoho.in  → Self Client. See docs/DEPLOY.md.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

ZOHO_PORTAL_ID=60083686827
ZOHO_ACCOUNTS_BASE=https://accounts.zoho.in

# If reads 404 with a token that is definitely valid, try the alternate host:
#   https://projectsapi.zoho.in/api/v3
ZOHO_API_BASE=https://projects.zoho.in/api/v3

# CORS is owned by Catalyst (whitelist the Slate origin under the project's CORS
# domains). Leave this unset there — if the function also sets the header the
# browser sees it twice and blocks the response. Set true only when serving the
# client from a different origin outside Catalyst.
# SEND_CORS_HEADERS=true

# Used only to build deep links back into the Zoho UI.
ZOHO_PORTAL_NAME=jeyasuriyadotjscmzohotestdotcom

# --- Session signing -------------------------------------------------------
# Generate with: openssl rand -base64 36
AUTH_SIGNING_KEY=
AUTH_TOKEN_TTL_SECONDS=28800

# --- Local server ----------------------------------------------------------
PORT=4000
NODE_ENV=development
