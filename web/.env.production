# Deployment configuration, committed to the repository.
#
# Next.js reads this at build and run time, so the value ships with the
# deployment. A console app variable still wins over this file if set.
#
# Safe to commit: this is a public endpoint, not a credential. Portal
# credentials live only on the API function, never here.

# ─────────────────────────────────────────────────────────────────────────────
# The API function that this app proxies to.
#
# It must end with /server/tnpc_api and must NOT have a trailing slash.
# Verify before deploying:
#   curl https://<host>/server/tnpc_api/health
# ─────────────────────────────────────────────────────────────────────────────
TNPC_API_URL=https://tnpowercenter-60083738829.development.catalystserverless.in/server/tnpc_api

# Do NOT set NEXT_PUBLIC_API_BASE here. It is read by the browser and would make
# the client call the function directly, bypassing the proxy and reintroducing
# cross-origin requests. TNPC_API_URL is server-side only, which is the point.
